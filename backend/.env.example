# ─────────────────────────────────────────────
#  Voice Form Assistant — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API (Speech-to-Text + Text-to-Speech)
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# MongoDB connection string
# Local:  mongodb://localhost:27017/voice-form-assistant
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/voice-form-assistant
MONGODB_URI=mongodb://localhost:27017/voice-form-assistant

# Express server port
PORT=5000

# OpenAI API Key (Image Generation - gpt-image-1-mini)
OPENAI_API_KEY=your_openai_api_key_here
